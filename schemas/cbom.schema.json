{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presencis.com/schemas/cbom.schema.json",
  "title": "Presencis CBOM",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "components", "alignment"],
  "properties": {
    "schema": { "const": "presencis-cbom-v1" },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "primitive", "parameter_set", "quantum_safety", "key_rotation"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 256 },
          "primitive": { "enum": ["symmetric", "asymmetric", "kem", "signature", "hash"] },
          "parameter_set": {
            "enum": [
              "ML-DSA-44",
              "ML-DSA-65",
              "ML-DSA-87",
              "ML-KEM-512",
              "ML-KEM-768",
              "ML-KEM-1024",
              "Ed25519",
              "X25519",
              "SHA-256",
              "SHA-384",
              "SHA-512",
              "AES-128-GCM",
              "AES-256-GCM",
              "ChaCha20-Poly1305"
            ]
          },
          "quantum_safety": { "enum": ["classical", "hybrid", "pqc"] },
          "key_rotation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["posture", "interval_days"],
            "properties": {
              "posture": { "enum": ["scheduled", "on-event", "manual", "none"] },
              "interval_days": { "type": "integer", "minimum": 0, "maximum": 36500 }
            }
          }
        }
      }
    },
    "alignment": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "enum": ["dora", "nis2", "cra"] }
    }
  }
}
