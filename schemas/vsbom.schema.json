{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presencis.com/schemas/vsbom.schema.json",
  "title": "Presencis VSBOM",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject", "postures"],
  "properties": {
    "schema": { "const": "presencis-vsbom-v1" },
    "subject": { "type": "string", "minLength": 1, "maxLength": 256 },
    "postures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "evidence"],
        "properties": {
          "kind": { "enum": ["fixed_vsbom", "living_vsbom", "fixed_aibom", "living_aibom"] },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state"],
            "properties": {
              "state": { "enum": ["judged", "cannot-tell", "untested"] },
              "evidence_id": { "type": "string", "minLength": 1, "maxLength": 256 },
              "scope": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "observed_at": { "type": "string", "minLength": 1, "maxLength": 64 },
              "method": { "type": "string", "minLength": 1, "maxLength": 256 },
              "limitations": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          },
          "generations": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "component_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "valid": { "type": "boolean" }
        }
      }
    }
  }
}
