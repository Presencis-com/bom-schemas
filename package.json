{
  "name": "@presencis/bom-schemas",
  "version": "0.1.0",
  "description": "JSON Schema Draft 2020-12 and Zod checks for Presencis AI-BOM, CBOM, and VSBOM posture manifests.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/schemas.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  },
  "author": "Presencis Ltd <github@presencis.com>",
  "homepage": "https://github.com/Presencis-com/bom-schemas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Presencis-com/bom-schemas.git"
  },
  "bugs": {
    "url": "https://github.com/Presencis-com/bom-schemas/issues"
  },
  "keywords": [
    "ai-bom",
    "cbom",
    "vsbom",
    "ai-governance",
    "eu-ai-act",
    "dora",
    "nis2",
    "json-schema",
    "zod"
  ],
  "publishConfig": {
    "access": "public"
  }
}
