{
  "name": "@presencis/bom-schemas",
  "version": "0.1.0",
  "description": "JSON Schema Draft 2020-12 and Zod checks for Presencis AI-BOM, CBOM, and VSBOM posture manifests.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
